// Esquema de base de datos — Proyecto Resplandecer
// Basado en database-spec.md
// Motor: PostgreSQL (Supabase)
//
// Convenciones (ver database-spec.md seccion 2):
//  - estado: true = activo (visible en la web), false = inactivo (oculto)
//  - creadoEn / actualizadoEn para trazabilidad
//  - Claves primarias:
//      usuarios y clientes -> uuid (datos sensibles / compatibilidad con auth)
//      contenido administrable -> bigint autoincremental (legible y simple)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL con connection pooling (pgBouncer) para el runtime serverless en Vercel
  url       = env("DATABASE_URL")
  // URL de conexion directa, requerida por Prisma para migraciones
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RolUsuario {
  administrador
}

enum TipoParametro {
  texto
  imagen
  numero
  booleano
}

// ---------------------------------------------------------------------------
// Gestion interna
// ---------------------------------------------------------------------------

/// Usuarios que ingresan al panel de administracion.
/// Solo el rol administrador puede editar las tablas parametricas.
model Usuario {
  id            String     @id @default(uuid()) @db.Uuid
  nombre        String
  email         String     @unique
  passwordHash  String     @map("password_hash")
  rol           RolUsuario @default(administrador)
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime   @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("usuarios")
}

/// Datos de clientes / contactos recibidos desde la web.
model Cliente {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  email         String?
  telefono      String?
  ciudad        String?
  mensaje       String?
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Contenido administrable (tablas parametricas)
// ---------------------------------------------------------------------------

/// Categorias del catalogo (ej. Comedores, Sillas, Barras).
model Categoria {
  id            BigInt   @id @default(autoincrement())
  nombre        String
  slug          String   @unique
  descripcion   String?
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  productos Catalogo[]

  @@map("categorias")
}

/// Productos / muebles del catalogo.
model Catalogo {
  id            BigInt   @id @default(autoincrement())
  nombre        String
  slug          String   @unique
  descripcion   String?
  precio        Decimal  @db.Decimal(12, 2)
  precioVenta   Decimal? @map("precio_venta") @db.Decimal(12, 2)
  categoriaId   BigInt?  @map("categoria_id")
  destacado     Boolean  @default(false)
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  categoria Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  imagenes  ImagenCatalogo[]

  @@index([categoriaId])
  @@map("catalogo")
}

/// Imagenes asociadas a cada producto del catalogo (galeria).
model ImagenCatalogo {
  id               BigInt   @id @default(autoincrement())
  catalogoId       BigInt   @map("catalogo_id")
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  esPrincipal      Boolean  @default(false) @map("es_principal")
  orden            Int      @default(0)
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)

  @@index([catalogoId])
  @@map("imagenes_catalogo")
}

/// Imagenes de los testimonios (foto de quien da el testimonio).
model ImagenTestimonio {
  id               BigInt   @id @default(autoincrement())
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  testimonios Testimonio[]

  @@map("imagenes_testimonios")
}

/// Testimonios de clientes que se muestran en la web.
model Testimonio {
  id            BigInt   @id @default(autoincrement())
  nombreCliente String   @map("nombre_cliente")
  cargoOCiudad  String?  @map("cargo_o_ciudad")
  mensaje       String
  calificacion  Int?
  imagenId      BigInt?  @map("imagen_id")
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  imagen ImagenTestimonio? @relation(fields: [imagenId], references: [id], onDelete: SetNull)

  @@index([imagenId])
  @@map("testimonios")
}

/// Redes sociales de la empresa que se muestran en la web.
model RedSocial {
  id            BigInt   @id @default(autoincrement())
  nombre        String
  url           String
  icono         String?
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("redes_sociales")
}

/// Parametros generales del sitio (clave-valor) para administrar textos y
/// contenido de la web sin tocar el HTML.
model ConfiguracionSitio {
  id            BigInt        @id @default(autoincrement())
  clave         String        @unique
  valor         String?
  tipo          TipoParametro @default(texto)
  descripcion   String?
  estado        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("configuracion_sitio")
}
