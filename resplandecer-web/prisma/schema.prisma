// Esquema de base de datos — Proyecto Resplandecer
// Basado en database-spec.md
// Motor: PostgreSQL (Supabase)
//
// Convenciones (ver database-spec.md seccion 2):
//  - estado: true = activo (visible en la web), false = inactivo (oculto)
//  - creadoEn / actualizadoEn para trazabilidad
//  - Claves primarias:
//      usuarios y clientes -> uuid (datos sensibles / compatibilidad con auth)
//      contenido administrable -> bigint autoincremental (legible y simple)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // URL con connection pooling (pgBouncer) para el runtime serverless en Vercel
  url       = env("DATABASE_URL")
  // URL de conexion directa, requerida por Prisma para migraciones
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum RolUsuario {
  administrador
}

enum TipoParametro {
  texto
  imagen
  numero
  booleano
}

// ---------------------------------------------------------------------------
// Gestion interna
// ---------------------------------------------------------------------------

/// Usuarios que ingresan al panel de administracion.
/// Solo el rol administrador puede editar las tablas parametricas.
model Usuario {
  id            String     @id @default(uuid()) @db.Uuid
  nombre        String
  email         String     @unique
  passwordHash  String     @map("password_hash")
  rol           RolUsuario @default(administrador)
  estado        Boolean    @default(true)
  creadoEn      DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime   @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("usuarios")
}

/// Datos de clientes / contactos recibidos desde la web.
model Cliente {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String
  email         String?
  telefono      String?
  ciudad        String?
  mensaje       String?
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Contenido administrable (tablas parametricas)
// ---------------------------------------------------------------------------

/// Categorias del catalogo (ej. Comedores, Sillas, Barras).
model Categoria {
  id                 BigInt   @id @default(autoincrement())
  nombre             String
  slug               String   @unique
  descripcion        String?
  imagenUrl          String?  @map("imagen_url")
  // Detalle de coleccion: mensaje/boton de WhatsApp administrables por coleccion.
  whatsappTexto      String?  @map("whatsapp_texto")
  whatsappMensaje    String?  @map("whatsapp_mensaje")
  orden              Int      @default(0)
  estado             Boolean  @default(true)
  creadoEn           DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn      DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  productos Catalogo[]
  imagenes  ImagenCategoria[]

  @@map("categorias")
}

/// Imagenes de la galeria de una categoria/coleccion (para el detalle).
model ImagenCategoria {
  id               BigInt   @id @default(autoincrement())
  categoriaId      BigInt   @map("categoria_id")
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  orden            Int      @default(0)
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId])
  @@map("imagenes_categoria")
}

/// Colecciones (concepto editorial). Entidad INDEPENDIENTE de categorias y
/// productos. Se listan en /colecciones y en el banner de colecciones del home.
model Coleccion {
  id              BigInt   @id @default(autoincrement())
  titulo          String
  slug            String   @unique
  resumen         String?
  descripcion     String?
  imagenUrl       String?  @map("imagen_url")
  imagenAlt       String?  @map("imagen_alt")
  whatsappTexto   String?  @map("whatsapp_texto")
  whatsappMensaje String?  @map("whatsapp_mensaje")
  orden           Int      @default(0)
  estado          Boolean  @default(true)
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  imagenes ImagenColeccion[]

  @@map("colecciones")
}

/// Imagenes de la galeria de una coleccion.
model ImagenColeccion {
  id               BigInt   @id @default(autoincrement())
  coleccionId      BigInt   @map("coleccion_id")
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  esPrincipal      Boolean  @default(false) @map("es_principal")
  orden            Int      @default(0)
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  coleccion Coleccion @relation(fields: [coleccionId], references: [id], onDelete: Cascade)

  @@index([coleccionId])
  @@map("imagenes_coleccion")
}

/// Productos / muebles del catalogo.
model Catalogo {
  id            BigInt   @id @default(autoincrement())
  nombre        String
  slug          String   @unique
  descripcion   String?
  precio        Decimal  @db.Decimal(12, 2)
  precioVenta   Decimal? @map("precio_venta") @db.Decimal(12, 2)
  categoriaId   BigInt?  @map("categoria_id")
  destacado     Boolean  @default(false)
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  categoria Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  imagenes  ImagenCatalogo[]

  @@index([categoriaId])
  @@map("catalogo")
}

/// Imagenes asociadas a cada producto del catalogo (galeria).
model ImagenCatalogo {
  id               BigInt   @id @default(autoincrement())
  catalogoId       BigInt   @map("catalogo_id")
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  esPrincipal      Boolean  @default(false) @map("es_principal")
  orden            Int      @default(0)
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  catalogo Catalogo @relation(fields: [catalogoId], references: [id], onDelete: Cascade)

  @@index([catalogoId])
  @@map("imagenes_catalogo")
}

/// Imagenes de los testimonios (foto de quien da el testimonio).
model ImagenTestimonio {
  id               BigInt   @id @default(autoincrement())
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  testimonios Testimonio[]

  @@map("imagenes_testimonios")
}

/// Testimonios de clientes que se muestran en la web.
model Testimonio {
  id            BigInt   @id @default(autoincrement())
  nombreCliente String   @map("nombre_cliente")
  cargoOCiudad  String?  @map("cargo_o_ciudad")
  mensaje       String
  calificacion  Int?
  imagenId      BigInt?  @map("imagen_id")
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  imagen ImagenTestimonio? @relation(fields: [imagenId], references: [id], onDelete: SetNull)

  @@index([imagenId])
  @@map("testimonios")
}

/// Redes sociales de la empresa que se muestran en la web.
model RedSocial {
  id            BigInt   @id @default(autoincrement())
  nombre        String
  url           String
  icono         String?
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("redes_sociales")
}

/// Parametros generales del sitio (clave-valor) para administrar textos y
/// contenido de la web sin tocar el HTML.
model ConfiguracionSitio {
  id            BigInt        @id @default(autoincrement())
  clave         String        @unique
  valor         String?
  tipo          TipoParametro @default(texto)
  descripcion   String?
  estado        Boolean       @default(true)
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("configuracion_sitio")
}

/// Paginas de contenido administrable (terminos y condiciones, nuestra historia).
model PaginaContenido {
  id            BigInt   @id @default(autoincrement())
  slug          String   @unique
  titulo        String
  subtitulo     String?
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  bloques BloqueContenido[]

  @@map("paginas_contenido")
}

/// Bloques (subtitulo + texto + imagen) de una pagina de contenido.
model BloqueContenido {
  id            BigInt   @id @default(autoincrement())
  paginaId      BigInt   @map("pagina_id")
  subtitulo     String?
  contenido     String
  imagenUrl     String?  @map("imagen_url")
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  pagina PaginaContenido @relation(fields: [paginaId], references: [id], onDelete: Cascade)

  @@index([paginaId])
  @@map("bloques_contenido")
}

/// Banners administrables del home: secciones "Mobiliario" y "Colecciones".
model HomeBanner {
  id            BigInt   @id @default(autoincrement())
  seccion       String   // "mobiliario" | "colecciones"
  titulo        String?
  subtitulo     String?
  etiqueta      String?  // texto sobre la imagen (ej. "Comedor Zafiro - Comedores")
  imagenUrl     String   @map("imagen_url")
  enlaceUrl     String?  @map("enlace_url")
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@index([seccion])
  @@map("home_banners")
}

/// Textos del marquee (cinta animada) de la pagina principal.
model MarqueeItem {
  id            BigInt   @id @default(autoincrement())
  texto         String
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("marquee_items")
}

/// Pasos del proceso "Diseña tu espacio" (administrables).
model PasoDiseno {
  id            BigInt   @id @default(autoincrement())
  titulo        String
  descripcion   String?
  imagenUrl     String?  @map("imagen_url")
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("pasos_diseno")
}

/// Preguntas frecuentes (FAQ) de la pagina principal.
model Faq {
  id            BigInt   @id @default(autoincrement())
  pregunta      String
  respuesta     String
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("faqs")
}

/// Servicios que se muestran en la seccion "Que hacemos".
model Servicio {
  id            BigInt   @id @default(autoincrement())
  titulo        String
  descripcion   String?
  imagenUrl     String?  @map("imagen_url")
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("servicios")
}

/// Metricas de la seccion de estadisticas (años de experiencia, artesanos, etc.).
model Metrica {
  id            BigInt   @id @default(autoincrement())
  valor         Int
  prefijo       String?
  sufijo        String?
  etiqueta      String
  orden         Int      @default(0)
  estado        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  @@map("metricas")
}

/// Proyectos realizados (galeria de trabajos). Contenido administrable.
model Proyecto {
  id            BigInt    @id @default(autoincrement())
  titulo        String
  slug          String    @unique
  descripcion   String?
  ubicacion     String?
  fecha         DateTime? @db.Date
  destacado     Boolean   @default(false)
  orden         Int       @default(0)
  estado        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  imagenes ImagenProyecto[]

  @@map("proyectos")
}

/// Imagenes asociadas a un proyecto (galeria).
model ImagenProyecto {
  id               BigInt   @id @default(autoincrement())
  proyectoId       BigInt   @map("proyecto_id")
  url              String
  textoAlternativo String?  @map("texto_alternativo")
  esPrincipal      Boolean  @default(false) @map("es_principal")
  orden            Int      @default(0)
  estado           Boolean  @default(true)
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
  @@map("imagenes_proyecto")
}
